#!/usr/bin/env bash
# diagram - render a d2 or svg source file to PNG for inline terminal display.
#
# Usage:
#   diagram <file.d2|file.svg> [-o out.png] [-w max_width] [-H max_height]
#   diagram -t d2|svg - [-o out.png]                  # source on stdin
#
# Prints the absolute path of the PNG on stdout. Read that path with the agent's
# `read` tool to render it inline in the terminal.

set -euo pipefail

die() {
	echo "diagram: $*" >&2
	exit 1
}

src=""
type=""
out=""
maxw=1200
maxh=1000

while [ $# -gt 0 ]; do
	case "$1" in
	-o)
		out="${2:?-o needs a path}"
		shift 2
		;;
	-w)
		maxw="${2:?-w needs a number}"
		shift 2
		;;
	-H)
		maxh="${2:?-H needs a number}"
		shift 2
		;;
	-t)
		type="${2:?-t needs d2 or svg}"
		shift 2
		;;
	-h | --help)
		sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	-)
		src="-"
		shift
		;;
	*)
		src="$1"
		shift
		;;
	esac
done

[ -n "$src" ] || die "no input; pass a file or - with -t"
command -v rsvg-convert >/dev/null || die "rsvg-convert not found (brew install librsvg)"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

if [ "$src" = "-" ]; then
	[ -n "$type" ] || die "reading stdin requires -t d2|svg"
	src="$tmp/in.$type"
	cat >"$src"
else
	[ -f "$src" ] || die "no such file: $src"
	[ -n "$type" ] || type="${src##*.}"
fi

case "$type" in
d2)
	command -v d2 >/dev/null || die "d2 not found (brew install d2)"
	svg="$tmp/out.svg"
	d2 --theme 0 --pad 20 "$src" "$svg" >/dev/null 2>"$tmp/err" ||
		{
			cat "$tmp/err" >&2
			die "d2 failed for $src"
		}
	;;
svg)
	grep -q "<svg" "$src" || die "no <svg> root element in $src"
	svg="$src"
	;;
*)
	die "unsupported type '$type' (expected d2 or svg)"
	;;
esac

if [ -z "$out" ]; then
	out="$(mktemp "${TMPDIR:-/tmp}/diagram.XXXXXX").png"
fi

# Fit the diagram into maxw x maxh without distorting narrow/tall shapes, and
# never upscale beyond 3x (rasterised text gets soft).
zoom="$(awk -v maxw="$maxw" -v maxh="$maxh" '
	match($0, /viewBox="[^"]+"/) {
		vb = substr($0, RSTART + 9, RLENGTH - 10)
		split(vb, a, /[ 	]+/)
		w = a[3] + 0; h = a[4] + 0
		if (w > 0 && h > 0) {
			z = maxw / w
			if (maxh / h < z) z = maxh / h
			if (z > 3) z = 3
			printf "%.4f", z
		}
		exit
	}
' "$svg")"

# White background: PNGs are rendered over the terminal background, and diagram
# strokes/text are dark. Explicit background keeps them readable in dark themes.
if [ -n "$zoom" ]; then
	rsvg-convert -b white -z "$zoom" "$svg" -o "$out" || die "rsvg-convert failed for $svg"
else
	rsvg-convert -b white -w "$maxw" "$svg" -o "$out" || die "rsvg-convert failed for $svg"
fi

cd "$(dirname "$out")" && printf '%s/%s\n' "$PWD" "$(basename "$out")"
